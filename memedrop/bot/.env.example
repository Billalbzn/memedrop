# En production (Fly), ces valeurs ne vont pas dans un fichier : les secrets
# (DISCORD_TOKEN, CLIENT_ID, LINK_SECRET) se posent avec `fly secrets set NOM=valeur`.

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord application/client ID
CLIENT_ID=your_application_id_here

# Local dev port (the host — Fly, Railway — provides PORT itself and this is ignored there)
WS_PORT=8765

# Optional: comma-separated guild IDs for instant slash-command registration during dev
DEV_GUILD_IDS=

# Secret used to sign zero-touch re-link tokens (HMAC). Set this to a long
# random string and keep it stable across redeploys — if it changes, every
# overlay must run /link once again. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=

# Dossier de store.json (favoris, groupes, stats) : sur Fly, le volume monté (ex. /data), sinon perdu à chaque déploiement.
DATA_DIR=

# Optionnel : URL publique des liens /tts envoyés aux overlays (défaut : https://<FLY_APP_NAME>.fly.dev).
PUBLIC_BASE_URL=

# Optionnel : clé API Klipy pour l'option `gif` (recherche de GIF) de /drop,
# /dropall et /dropgroup. Sans elle, l'option répond « pas configurée » et le
# reste du bot marche normalement (on utilise `media`). Clé gratuite sur
# https://klipy.com/developers — sur Fly : fly secrets set KLIPY_API_KEY=...
KLIPY_API_KEY=
