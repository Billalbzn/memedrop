# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord application/client ID
CLIENT_ID=your_application_id_here

# Local dev port (Fly.io sets PORT via fly.toml [env] and ignores this)
WS_PORT=8765

# Optional: comma-separated guild IDs for instant slash-command registration during dev
DEV_GUILD_IDS=

# Secret used to sign zero-touch re-link tokens (HMAC). Set this to a long
# random string and keep it stable across redeploys — if it changes, every
# overlay must run /link once again. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=

# Optional: Klipy API key for the `gif` search option on /drop, /dropall and
# /dropgroup. Without it, that option's autocomplete returns no results (the
# rest of the bot works fine, users just use `media` instead). Get a free key
# at https://klipy.com/developers (Tenor's API is shutting down in 2026, this
# is the closest drop-in replacement).
KLIPY_API_KEY=
